{
  "manifest_version": 3,
  "name": "GFlow 登录助手",
  "version": "0.1.0",
  "description": "将当前浏览器的 Google Flow 登录态同步到本机 EasyCPA GFlow 插件。",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://flow.google.com/*", "https://google.com/*", "https://*.google.com/*"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://127.0.0.1/*", "https://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "GFlow 登录助手", "default_popup": "popup.html"},
  "homepage_url": "https://github.com/daodeqing/cpa-plugin-GFlow/tree/main/browser-extension"
}
